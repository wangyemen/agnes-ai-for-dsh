{
  "name": "agnes-ai-for-dsh",
  "description": "Agnes AI integration for DeepSeek Harness - text, image, and video generation via Agnes AI API",
  "version": "0.2.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wangyemen/agnes-ai-for-dsh"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/types.ts",
  "exports": {
    ".": {
      "types": "./src/types.ts",
      "default": "./src/index.ts"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*",
    "lib/**/*",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "tsconfig.json"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "echo 'TypeScript source included directly'"
  }
}
